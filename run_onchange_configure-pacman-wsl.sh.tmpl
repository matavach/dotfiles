{{ if and (contains "arch" .chezmoi.osRelease.id) (contains "WSL" .chezmoi.kernel.osrelease) -}}
#!/bin/bash
# On WSL behind a TLS-inspecting corporate proxy, pacman's low-speed timeout
# (<1 B/s for 10s) aborts downloads while the proxy scans/buffers the response.
# DisableDownloadTimeout turns that check off. Idempotent: only edits if the
# option isn't already active.
set -eu

if ! grep -q '^DisableDownloadTimeout' /etc/pacman.conf; then
  echo 'Enabling DisableDownloadTimeout in /etc/pacman.conf (WSL/proxy fix)'
  if grep -q '^#DisableDownloadTimeout' /etc/pacman.conf; then
    sudo sed -i 's/^#DisableDownloadTimeout/DisableDownloadTimeout/' /etc/pacman.conf
  else
    sudo sed -i '/^\[options\]/a DisableDownloadTimeout' /etc/pacman.conf
  fi
fi
{{ end -}}
