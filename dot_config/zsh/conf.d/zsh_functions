lg() {
  git add .;
  git commit -m "$@"
  git push
}

# nvim leaves a block cursor behind on exit (DECSCUSR has no save/restore).
# Wrap nvim to restore the blinking-bar cursor right after it exits. Doing it
# here — instead of in a precmd/zle hook — keeps the escape out of Powerlevel10k's
# prompt-render cycle, which otherwise caused a blank line (precmd) or a cursor
# flash at column 0 (zle line-init).
nvim() {
  command nvim "$@"
  local ret=$?
  print -n '\e[5 q'
  return $ret
}
