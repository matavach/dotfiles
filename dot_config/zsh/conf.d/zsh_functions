gs() {
	git status "$@"
}
ga() {
	git add "$@"
}
gc() { 
	git commit "$@"
}
gps() {
	git push "$@"
}
gpl() {
	git pull "$@"
}

c() {
  if [[ -z "$@" ]]; then
    code $(pwd)
  else
    code "$@"
  fi
}

curl() {
  if [[ "$*" == *"-s"* ]]; then
    command curl "$@" | jq .
  else
    command curl "$@"
  fi
}

az() {
  if [[ "$*" == *"-o table" ]]; then
    command az "$@" | tv -c 3 -a -R --force-all-rows --jump-invalid-rows -D
  elif [[ "$*" == *"-o tsv" ]]; then
    command az "$@" | tv -c 3 -a -R --force-all-rows --jump-invalid-rows -D
  else
    command az "$@" | jq .
  fi
}

lg() {
  git add .;
  git commit -m "$@"
  git push
}
