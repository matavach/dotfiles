gs() {
	git status "$@"
}
ga() {
	git add "$@"
}
gc() { 
	git commit "$@"
}
gps() {
	git push "$@"
}
gpl() {
	git pull "$@"
}

c() {
  if [[ -z "$@" ]]; then
    code $(pwd)
  else
    code "$@"
  fi
}

az() {
  if [[ "$*" == *"-o table" ]]; then
    command az "$@"
  elif [[ "$*" == *"-o tsv" ]]; then
    command az "$@"
  else
    command az "$@" | jq .
  fi
}

lg() {
  git add .;
  git commit -m "$@"
  git push
}
