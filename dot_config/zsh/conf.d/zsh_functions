gs() {
	git status "$@"
}
ga() {
	git add "$@"
}
gc() { 
	git commit "$@"
}
gps() {
	git push "$@"
}
gpl() {
	git pull "$@"
}

c() {
  if [[ -z "$@" ]]; then
    code $(pwd)
  else
    code "$@"
  fi
}

az() {
    if [[ "$*" == *"-s"* ]]; then
        command az "$@" | jq .
    else
        command az "$@"
    fi
}

lg() {
  git add .;
  git commit -m "$@"
  git push
}
