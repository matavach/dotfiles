gs() {
	git status "$@"
}
ga() {
	git add "$@"
}
gc() { 
	git commit "$@"
}
gps() {
	git push "$@"
}
gpl() {
	git pull "$@"
}

c() {
  if [[ -z "$@" ]]; then
    code $(pwd)
  else
    code "$@"
  fi
}

curl() {
  TEMP=$(mktemp)
  if [[ "$*" == *"-s"* ]]; then
    command curl "$@" > "$TEMP"
    if [[ $(file "$TEMP") == *"HTML"* ]]; then
      command pup -f $TEMP -p -i 2 | bat --no-paging --no-config --decorations=never --theme=ansi
    elif [[ $(file "$TEMP") == *"JSON"* ]]; then
      command jq '.' $TEMP
    else
      command bat $TEMP --no-paging --no-config --decorations=never --theme=ansi
    fi
  else
    command curl "$@"
  fi
}

