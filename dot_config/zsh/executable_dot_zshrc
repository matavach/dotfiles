if [[ "${ZSH_DEBUG}" == "1" ]]; then
	zmodload zsh/zprof
fi

if [[ -n $GHOSTTY_RESOURCES_DIR ]]; then
  source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
fi

export GALLIUM_DRIVER=d3d12
export LIBVA_DRIVER_NAME=d3d12

# Enable Powerlevel10k instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
 source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

setopt complete_aliases

# Set colors for folders/etc
eval "$(dircolors -b "$ZDOTDIR/dircolors")"

# Antidote
source /usr/share/zsh-antidote/antidote.zsh
zstyle ':antidote:bundle' use-friendly-names 'yes'
# Byte-compile the static load file and bundles (.zwc) for faster sourcing.
zstyle ':antidote:*' zcompile 'yes'
antidote load

# Completion generator (RobSis/zsh-completion-generator) is expensive at load and
# only needed on demand to run `gencomp`. Load it only when ZSH_GENCOMP=1.
if [[ "${ZSH_GENCOMP}" == "1" ]]; then
  _gencomp_plugin="${ANTIDOTE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/antidote}/RobSis/zsh-completion-generator/zsh-completion-generator.plugin.zsh"
  [[ -r "$_gencomp_plugin" ]] && source "$_gencomp_plugin"
  unset _gencomp_plugin
fi

# Source plugins
for _rc in $ZDOTDIR/conf.d/*; do
  source "$_rc"
done
unset _rc

for _rc in $ZDOTDIR/plugins.d/*; do
  source "$_rc"
done
unset _rc

# To customize prompt, run `p10k configure` or edit ~/.config/zsh/.p10k.zsh.
[[ ! -f "$ZDOTDIR/.p10k.zsh" ]] || source "$ZDOTDIR/.p10k.zsh"
