if [[ "${ZSH_DEBUG}" == "1" ]]; then
	zmodload zsh/zprof
fi

if [[ -n $GHOSTTY_RESOURCES_DIR ]]; then
  source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
fi

export GALLIUM_DRIVER=d3d12
export LIBVA_DRIVER_NAME=d3d12

# Enable Powerlevel10k instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
 source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

setopt complete_aliases

# Set colors for folders/etc (cached; dircolors only runs when the source changes)
_dircolors_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/dircolors.zsh"
if [[ ! -s "$_dircolors_cache" || "$ZDOTDIR/dircolors" -nt "$_dircolors_cache" ]]; then
  mkdir -p "${_dircolors_cache:h}"
  dircolors -b "$ZDOTDIR/dircolors" > "$_dircolors_cache"
fi
source "$_dircolors_cache"
unset _dircolors_cache

# Antidote
source /usr/share/zsh-antidote/antidote.zsh
zstyle ':antidote:bundle' use-friendly-names 'yes'
# Byte-compile the static load file and bundles (.zwc) for faster sourcing.
zstyle ':antidote:*' zcompile 'yes'
antidote load

# Completion generator (RobSis/zsh-completion-generator) is expensive at load and
# only needed on demand to run `gencomp`. Load it only when ZSH_GENCOMP=1.
if [[ "${ZSH_GENCOMP}" == "1" ]]; then
  _gencomp_plugin="${ANTIDOTE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/antidote}/RobSis/zsh-completion-generator/zsh-completion-generator.plugin.zsh"
  [[ -r "$_gencomp_plugin" ]] && source "$_gencomp_plugin"
  unset _gencomp_plugin
fi

# Source plugins (skip compiled .zwc siblings; `source` auto-uses them).
for _rc in $ZDOTDIR/conf.d/*(.N); do
  [[ $_rc == *.zwc ]] && continue
  source "$_rc"
done
unset _rc

for _rc in $ZDOTDIR/plugins.d/*(.N); do
  [[ $_rc == *.zwc ]] && continue
  source "$_rc"
done
unset _rc

# To customize prompt, run `p10k configure` or edit ~/.config/zsh/.p10k.zsh.
[[ ! -f "$ZDOTDIR/.p10k.zsh" ]] || source "$ZDOTDIR/.p10k.zsh"

# Byte-compile personal config in the background so future startups load the
# faster .zwc versions. `source`/zsh startup auto-use a .zwc when it's current.
() {
  emulate -L zsh
  local f
  for f in $ZDOTDIR/.zshrc $ZDOTDIR/.p10k.zsh $ZDOTDIR/conf.d/*(.N) $ZDOTDIR/plugins.d/*(.N); do
    [[ $f == *.zwc ]] && continue
    [[ -s $f && ( ! -s $f.zwc || $f -nt $f.zwc ) ]] && zcompile -R -- $f.zwc $f
  done
} &!
