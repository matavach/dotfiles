#compdef terraform

local -a _terraform_cmds opt_args
local ret=1
_terraform_cmds=(
    'apply:Create or update infrastructure'
    'console:Try Terraform expressions at an interactive command prompt'
    'destroy:Destroy previously-created infrastructure'
    'fmt:Reformat your configuration in the standard style'
    'force-unlock:Release a stuck lock on the current workspace'
    'get:Install or upgrade remote Terraform modules'
    'graph:Generate a Graphviz graph of the steps in an operation'
    'import:Associate existing infrastructure with a Terraform resource'
    'init:Prepare your working directory for other commands'
    'login:Obtain and save credentials for a remote host'
    'logout:Remove locally-stored credentials for a remote host'
    'metadata:Metadata related commands'
    'modules:Show all declared modules in a working directory'
    'output:Show output values from your root module'
    'plan:Show changes required by the current configuration'
    'providers:Show the providers required for this configuration'
    'refresh:Update the state to match remote systems'
    'show:Show the current state or a saved plan'
    'stacks:Manage HCP Terraform stack operations'
    'state:Advanced state management'
    'taint:Mark a resource instance as not fully functional'
    'test:Execute integration tests for Terraform modules'
    'untaint:Remove the tainted state from a resource instance'
    'validate:Check whether the configuration is valid'
    'version:Show the current Terraform version'
    'workspace:Workspace management'
)

_terraform_commands() {
  _describe -t commands "terraform command" _terraform_cmds
}

__statelist() {
  compadd $(terraform state list $opt_args[-state])
}

_arguments -C \
    '-help[show help message]' \
    '-chdir=[(DIR) Switch to a different working directory before executing the given subcommand.]' \
    '-version[print out the installed version of Terraform]' \
    '1: :_terraform_commands' \
    '*:: :->args' && ret=0

case $state in
  args)
    case $words[1] in
  apply)
    _arguments \
        '-auto-approve[Skip interactive approval of plan before applying]' \
        '-backup=[(path) Backup existing state file before modifying]:file:_files' \
        '-compact-warnings[Show warnings in compact form]' \
        '-destroy[Destroy Terraform-managed infrastructure]' \
        '-input=[(true) Ask for input for variables if not set]' \
        '-lock=[(false) Don'\''t hold state lock during operation]:lock:(true false)' \
        '-lock-timeout=[(0s) Duration to retry a state lock]' \
        '-no-color[Disable colored output]' \
        '-parallelism=[(n) Limit parallel resource operations]' \
        '-replace=[(resource) Force replacement of resource]:replace:__statelist' \
        '-state=[(path) Path to read and save state]:file:_files' \
        '-state-out=[(path) Write state to different file]:file:_files' \
        '*-var=[(foo=bar) Set input variable value]:var:' \
        '*-var-file=[(filename) Load variables from file]:file:_files' \
        && ret=0
    ;;
  console)
    _arguments \
        '-state=[(path) Legacy option for the local backend]:file:_files' \
        '-plan[Evaluate against planned state instead of current]' \
        '*-var=[(foo=bar) Set a variable in the configuration]:var:' \
        '*-var-file=[(foo) Set variables from file]:file:_files' \
        && ret=0
    ;;
  destroy)
    _arguments \
        '-auto-approve[Skip interactive approval before applying]' \
        '-compact-warnings[Show warnings in compact form]' \
        '-input=[(true) Ask for input for variables if not set]' \
        '-json[Produce output in machine-readable JSON format]' \
        '-lock=[(false) Don'\''t hold state lock during operation]' \
        '-lock-timeout=[(0s) Duration to retry a state lock]' \
        '-no-color[Disable colored output]' \
        '-parallelism=[(10) Limit parallel resource operations]' \
        '-replace=[(resource) Force replacement of resource]:target:__statelist' \
        '-target=[(resource) Limit operation to given resources]:target:__statelist' \
        '*-var=[(assignment) Set a variable in the configuration]:assignment' \
        '*-var-file=[(filename) Set variables from file]:file:_files' \
        && ret=0
    ;;
  fmt)
    _arguments \
        '-list=[(false) List files whose formatting differs]' \
        '-write=[(false) Write result to source file instead of STDOUT]' \
        '-diff[Display diffs of formatting changes]' \
        '-check[Check if input is formatted]' \
        '-no-color[Disable colored output]' \
        '-recursive[Also process files in subdirectories]' \
        '*:target:_files' \
        && ret=0
    ;;
  force-unlock)
    _arguments \
        '-force[Skip confirmation prompt for unlock]' \
        ':lock-id:' \
        && ret=0
    ;;
  get)
    _arguments \
        '-update[Check modules for updates and install newest versions]' \
        '-no-color[Disable text coloring in the output]' \
        '-test-directory=[(path) Set Terraform test directory]:directory:_directories' \
        && ret=0
    ;;
  graph)
    _arguments \
        '-plan=[(tfplan) Render graph using specified plan file]:file:_files' \
        '-draw-cycles[Highlight cycles with colored edges]' \
        '-type=[(TYPE) Type of operation graph to output]:type:(plan plan-refresh-only plan-destroy apply)' \
        '-module-depth=[(n) Deprecated: depth of modules to show]' \
        && ret=0
    ;;
  import)
    _arguments \
        '-config=[(path) Path to Terraform configuration files]:directory:_directories' \
        '-input=[(false) Disable interactive input prompts]' \
        '-lock=[(false) Don'\''t hold state lock during operation]' \
        '-lock-timeout=[(0s) Duration to retry a state lock]' \
        '-no-color[Disable colored output]' \
        '*-var=[(foo=bar) Set variable in configuration]:assignment' \
        '*-var-file=[(foo) Set variables from file]:file:_files' \
        '-ignore-remote-version[Ignore remote version checking]' \
        ':address:' \
        ':id:' \
        && ret=0
    ;;
  init)
    _arguments \
        '-backend=[(false) Disable backend/HCP Terraform initialization]' \
        '*-backend-config=[(path) Configuration for backend block]:file:_files' \
        '-force-copy[Suppress prompts about copying state data]' \
        '-from-module=[(SOURCE) Copy module contents before init]:module' \
        '-get=[(false) Disable downloading modules]' \
        '-input=[(false) Disable interactive prompts]' \
        '-json[Machine readable output in JSON format]' \
        '-lock=[(false) Don'\''t hold state lock during migration]' \
        '-lock-timeout=[(0s) Duration to retry a state lock]' \
        '-lockfile=[(MODE) Set dependency lockfile mode]:mode:(readonly)' \
        '-migrate-state[Reconfigure backend and migrate state]' \
        '-no-color[Disable colored output]' \
        '*-plugin-dir=[(path) Directory containing plugin binaries]:directory:_directories' \
        '-reconfigure[Reconfigure backend, ignoring saved config]' \
        '-test-directory=[(path) Set Terraform test directory]:directory:_directories' \
        '-upgrade[Install latest module and provider versions]' \
        '-ignore-remote-version[Ignore remote version compatibility]' \
        && ret=0
    ;;
  login)
    _arguments \
        ':hostname:' \
        && ret=0
    ;;
  logout)
    _arguments \
        ':hostname:' \
        && ret=0
    ;;
  metadata)
    if test $CURRENT -lt 3; then
        local -a __metadata_cmds
        __metadata_cmds=(
            'functions:Show signatures and descriptions for available functions'
        )
        _describe -t metadata "metadata commands" __metadata_cmds && ret=0
    else
        case $words[2] in
            functions)
                _arguments \
                    '-json[If specified, machine readable output will be printed in JSON format]' \
                    && ret=0
                ;;
        esac
    fi
    ;;
  modules)
    _arguments \
        '-json[If specified, machine readable output will be printed in JSON format]' \
        && ret=0
    ;;
  output)
    _arguments \
        '-state=[(path) Path to state file to read]:file:_files' \
        '-no-color[Disable colored output]' \
        '-json[Machine readable output in JSON format]' \
        '-raw[Print raw string directly]' \
        ':name:' \
        && ret=0
    ;;
  plan)
    _arguments \
        '-compact-warnings[Show warnings in compact form]' \
        '-destroy[Select destroy planning mode]' \
        '-detailed-exitcode[Return detailed exit codes]' \
        '-generate-config-out=[(path) Write HCL config for imported resources]:file:_files' \
        '-input=[(true) Ask for input for variables if not set]' \
        '-lock=[(false) Don'\''t hold state lock during operation]' \
        '-lock-timeout=[(0s) Duration to retry a state lock]' \
        '-no-color[Disable colored output]' \
        '-out=[(path) Write plan file to given path]:file:_files' \
        '-parallelism=[(n) Limit concurrent operations]' \
        '-refresh=[(false) Skip checking external changes]' \
        '-refresh-only[Select refresh only planning mode]' \
        '*-replace=[(resource) Force replacement of resource]:target:__statelist' \
        '-state=[(statefile) Path to read and save state]:file:_files' \
        '*-target=[(resource) Limit planning to given resources]:target:__statelist' \
        '*-var=[(foo=bar) Set input variable value]:assignment' \
        '*-var-file=[(filename) Load variables from file]:file:_files' \
        && ret=0
    ;;
  providers)
    if test $CURRENT -lt 3; then
        local -a __providers_cmds
        __providers_cmds=(
            'lock:Write out dependency locks for configured providers'
            'mirror:Save local copies of required provider plugins'
            'schema:Show schemas for providers used in configuration'
        )
        _describe -t providers "providers commands" __providers_cmds && ret=0
    else
        _arguments \
            '-test-directory=[(path) Set Terraform test directory]:directory:_directories' \
            '*:dir:_directories' \
            && ret=0
    fi
    ;;
  refresh)
    _arguments \
        '-compact-warnings[Show warnings in compact form]' \
        '-input=[(true) Ask for input for variables if not set]' \
        '-lock=[(false) Don'\''t hold state lock during operation]' \
        '-lock-timeout=[(0s) Duration to retry a state lock]' \
        '-no-color[Disable colored output]' \
        '-parallelism=[(n) Limit concurrent operations]' \
        '*-target=[(resource) Limit to specific resources]:target:__statelist' \
        '*-var=[(foo=bar) Set variable in configuration]:assignment' \
        '*-var-file=[(foo) Set variables from file]:file:_files' \
        && ret=0
    ;;
  show)
    _arguments \
        '-no-color[Disable colored output]' \
        '-json[Output in machine-readable JSON form]' \
        ':path:_files' \
        && ret=0
    ;;
  stacks)
    _message "no more options"
    ;;
  state)
    if test $CURRENT -lt 3; then
        local -a __state_cmds
        __state_cmds=(
          'identities:List identities of resources in state'
          'list:List resources in the state'
          'mv:Move an item in the state'
          'pull:Pull current state and output to stdout'
          'push:Update remote state from a local state file'
          'replace-provider:Replace provider in the state'
          'rm:Remove instances from the state' 
          'show:Show a resource in the state'
        )
        _describe -t state "state commands" __state_cmds && ret=0
    else
        case $words[2] in
            list)
                _arguments \
                    '-state=[(path) Path to a Terraform state file to use to look up Terraform-managed resources. By default it will use the state "terraform.tfstate" if it exists.]' \
                    '-id=[(id) Filters the results to include only instances whose resource types have an attribute named id whose value equals the given id string.]' \
                    "*:address:__statelist" \
                    && ret=0
                ;;
            mv)
                _arguments \
                    "-dry-run[If set, prints out what would've been moved but doesn't actually move anything.]" \
                    "-backup=[(path) Path where Terraform should write the backup for the original state. This cannot be disabled. If not set, Terraform will write it to the same path as the statefile with a \".backup\" extension.]:file:_files" \
                    "-backup-out=[(path) Path where Terraform should write the backup for the destination state. This cannot be disabled. If not set, Terraform will write it to the same path as the destination state file with a backup extension. This only needs to be specified if -state-out is set to a different path than -state.]:file:_files" \
                    "-lock=[(true|false) Lock the state files when locking is supported.]:lock:(true false)" \
                    "-lock-timeout=[(seconds) Duration to retry a state lock.]" \
                    '-state=[(path) Path to the source state file. Defaults to the configured backend, or "terraform.tfstate"]:file:_files' \
                    "-state-out=[(path) Path to the destination state file to write to. If this is not specified, the source state file will be used. This can be a new or existing path.]:file:_files" \
                    "::" \
                    ":source:__statelist" \
                    ":destination: " \
                    && ret=0
                ;;
            push)
                _arguments \
                    "-force[Write the state even if lineages do not match or the remote serial is higher.]" \
                    '-lock=[(true|false) Lock the state file when locking is supported.]:lock:(true false)' \
                    "-lock-timeout=[(seconds) Duration to retry a state lock.]" \
                    "::" \
                    ":destination:_files" \
                    && ret=0
                ;;
            rm)
                _arguments \
                    "-dry-run[If set, prints out what would've been removed but doesn't actually remove anything.]" \
                    "-backup=[(path) Path where Terraform should write the backup for the original state.]:file:_files" \
                    "-lock=[(true|false) Lock the state files when locking is supported.]:lock:(true false)" \
                    "-lock-timeout=[(seconds) Duration to retry a state lock.]" \
                    '-state=[(path) Path to the state file to update. Defaults to the current workspace state.]:file:_files' \
                    "*:address:__statelist" \
                    && ret=0
                ;;
            show)
                _arguments \
                    '-state=[(path) Path to a Terraform state file to use to look up Terraform-managed resources. By default it will use the state "terraform.tfstate" if it exists.]' \
                    "*:address:__statelist" \
                    && ret=0
                ;;
        esac
    fi
    ;;
  taint)
    _arguments \
        '-allow-missing[If specified, the command will succeed (exit code 0) even if the resource is missing.]' \
        '-backup=[(path) Path to backup the existing state file before modifying. Defaults to the "-state-out" path with ".backup" extension. Set to "-" to disable backup.]' \
        '-lock=[(true) Lock the state file when locking is supported.]' \
        '-lock-timeout=[(0s) Duration to retry a state lock.]' \
        '-module=[(path)  The module path where the resource lives. By default this will be root. Child modules can be specified by names. Ex. "consul" or "consul.vpc" (nested modules).]' \
        '-no-color[If specified, output will not contain any color.]' \
        '-state=[(path) Path to read and save state (unless state-out is  specified). Defaults to "terraform.tfstate".]' \
        '-state-out=[(path) Path to write updated state file. By default, the "-state" path will be used.]' \
        "*:address:__statelist" \
        && ret=0
    ;;
  test)
    _arguments \
        '-cloud-run=[(source) Execute this test run remotely using HCP Terraform or Terraform Enterprise.]:source:' \
        '-filter=[(testfile) Only execute the test files specified by this flag.]:testfile:_files' \
        '-json[If specified, machine readable output will be printed in JSON format]' \
        '-junit-xml=[(path) Saves a test report in JUnit XML format to the specified file.]:path:_files' \
        '-no-color[If specified, output will not contain any color.]' \
        '-parallelism=[(10) Limit the number of concurrent operations within the plan/apply operation of a test run.]:number:' \
        '-test-directory=[(tests) Set the Terraform test directory.]:path:_files -/' \
        '*-var=[(foo=bar) Set a value for one of the input variables in the root module.]:var:' \
        '*-var-file=[(filename) Load variable values from the given file.]:file:_files' \
        '-verbose[Print the plan or state for each test run block as it executes.]' \
        && ret=0
    ;;
  untaint)
    _arguments \
        '-allow-missing[If specified, the command will succeed (exit code 0) even if the resource is missing.]' \
        '-backup=[(path) Path to backup the existing state file before modifying. Defaults to the "-state-out" path with ".backup" extension. Set to "-" to disable backup.]' \
        '-lock=[(true) Lock the state file when locking is supported.]' \
        '-lock-timeout=[(0s) Duration to retry a state lock.]' \
        '-module=[(path)  The module path where the resource lives. By default this will be root. Child modules can be specified by names. Ex. "consul" or "consul.vpc" (nested modules).]' \
        '-no-color[If specified, output will not contain any color.]' \
        '-state=[(path) Path to read and save state (unless state-out is  specified). Defaults to "terraform.tfstate".]' \
        '-state-out=[(path) Path to write updated state file. By default, the "-state" path will be used.]' \
        && ret=0
    ;;
  validate)
    _arguments \
        '-json[Produce output in a machine-readable JSON format, suitable for use in text editor integrations and other automated systems. Always disables color.]' \
        '-no-color[If specified, output will not contain any color.]' \
        '-no-tests[If specified, Terraform will not validate test files.]' \
        '-test-directory=[(path) Set the Terraform test directory, defaults to tests.]:directory:_directories' \
        && ret=0
    ;;
  workspace)
    if test $CURRENT -lt 3; then
        local -a __workspace_cmds
        __workspace_cmds=(
            'delete:Delete a workspace'
            'list:List Workspaces'
            'new:Create a new workspace'
            'select:Select a workspace'
            'show:Show the name of the current workspace'
        )
        _describe -t workspace "workspace commands" __workspace_cmds && ret=0
    fi
    ;;
  esac
  ;;
esac

return ret
