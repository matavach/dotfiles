# Generated / compiled artifacts — rebuilt automatically on each machine.
# Track only the source files; never store build output in source control.

# Byte-compiled zsh files (arch/zsh-version specific; regenerated by .zshrc).
*.zwc

# compinit dump (regenerated on first shell start).
.config/zsh/.zcompdump*

# antidote's static load file (generated from .zsh_plugins.txt by `antidote load`).
.config/zsh/.zsh_plugins.zsh

# Cached dircolors output (regenerated when the dircolors source changes).
.cache/zsh/dircolors.zsh

# Cached chezmoi completion (regenerated when the chezmoi binary changes).
.cache/zsh/chezmoi-completion.zsh

# Shell history and history-derived caches — machine-local state, never synced.
.config/zsh/.zsh_history
.cache/zsh/.zsh_history
.cache/zsh/history-commands

# WSL-only files: skip on non-WSL machines (Firefox wrapper is only used under WSL).
{{ if not (contains "WSL" .chezmoi.kernel.osrelease) }}
.local/bin/firefox-open
.local/share/applications/firefox.desktop
{{ end }}

# Copilot global agent instructions — machine-local only. Contains internal
# environment details (corp proxy/CA paths, workplace conventions) that must not
# be published to this public repo. Keep it at ~/.config/copilot/AGENTS.md,
# untracked.
.config/copilot
